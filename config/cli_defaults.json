{
  "_source": "gym_continuousDoubleAuction/train/train.py (_parse_args) and gym_continuousDoubleAuction/CDA_env_rand.py (main)",
  "_description": "Command-line flags exposed by the two entry points, with their argparse defaults and the TrainConfig/function field each maps to.",

  "train": {
    "_module": "python -m gym_continuousDoubleAuction.train.train",
    "--agents": { "dest": "num_agents", "type": "int", "default": 8 },
    "--trained-agents": { "dest": "num_trained_agents", "type": "int", "default": 2 },
    "--iters": { "dest": "num_iters", "type": "int", "default": 16 },
    "--max-step": { "dest": "max_step", "type": "int", "default": 4096 },
    "--env-runners": { "dest": "num_env_runners", "type": "int", "default": 0 },
    "--envs-per-runner": { "dest": "num_envs_per_env_runner", "type": "int", "default": 1 },
    "--gpus-per-learner": { "dest": "num_gpus_per_learner", "type": "float", "default": 0.75 },
    "--restore": { "dest": "is_restore", "type": "flag", "default": false },
    "--log-base-dir": { "dest": "log_base_dir", "type": "str", "default": "results" },
    "--log-level": { "dest": "log_level", "type": "str", "default": "WARN" },
    "--seed": { "dest": "seed", "type": "int", "default": null },
    "--no-episode-data": { "dest": "episode_data_dir", "type": "flag", "default": false, "effect": "sets episode_data_dir to null" }
  },

  "cda_env_rand": {
    "_module": "python -m gym_continuousDoubleAuction.CDA_env_rand",
    "--agents": { "dest": "num_agents", "type": "int", "default": 4 },
    "--steps": { "dest": "max_step", "type": "int", "default": 1000 },
    "--init-cash": { "dest": "init_cash", "type": "int", "default": 1000000 },
    "--render": { "dest": "is_render", "type": "flag", "default": false },
    "--seed": { "dest": "seed", "type": "int", "default": null }
  }
}
